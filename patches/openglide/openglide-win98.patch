diff --git a/lfbtrace.cpp b/lfbtrace.cpp
new file mode 100644
index 0000000..6b91f2e
--- /dev/null
+++ b/lfbtrace.cpp
@@ -0,0 +1,86 @@
+//**************************************************************
+//*  Optional call counting, to see how a game uses the frame buffer.
+//*
+//*  Off unless a file named LFBTRACE.ON is in the current folder (usually the
+//*  game's). Then every LfbTrace() call counts its text, and every 2 seconds the
+//*  counts are written to LFBTRACE.TXT in the same folder, most frequent first.
+//**************************************************************
+
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+
+#include "GlOgl.h"
+
+#define TRACE_KEYS 128
+
+static int  traceState = -1;   // -1 unknown, 0 off, 1 on
+static char traceKey[ TRACE_KEYS ][ 96 ];
+static FxU32 traceCount[ TRACE_KEYS ];
+static int  traceUsed;
+static DWORD traceLastWrite;
+
+static void LfbTraceWrite( void )
+{
+    FILE *f = fopen( "LFBTRACE.TXT", "w" );
+    int order[ TRACE_KEYS ], i, j;
+
+    if ( !f )
+        return;
+    for ( i = 0; i < traceUsed; i++ )
+        order[ i ] = i;
+    for ( i = 0; i < traceUsed; i++ )
+        for ( j = i + 1; j < traceUsed; j++ )
+            if ( traceCount[ order[ j ] ] > traceCount[ order[ i ] ] )
+            {
+                int t = order[ i ];
+                order[ i ] = order[ j ];
+                order[ j ] = t;
+            }
+    for ( i = 0; i < traceUsed; i++ )
+        fprintf( f, "%8lu  %s\n", (unsigned long)traceCount[ order[ i ] ], traceKey[ order[ i ] ] );
+    fclose( f );
+}
+
+void LfbTrace( const char *fmt, ... )
+{
+    char key[ 96 ];
+    va_list ap;
+    int i;
+
+    if ( traceState < 0 )
+    {
+        FILE *f = fopen( "LFBTRACE.ON", "r" );
+        traceState = f != NULL;
+        if ( f )
+            fclose( f );
+    }
+    if ( !traceState )
+        return;
+
+    va_start( ap, fmt );
+    _vsnprintf( key, sizeof( key ) - 1, fmt, ap );
+    va_end( ap );
+    key[ sizeof( key ) - 1 ] = 0;
+
+    for ( i = 0; i < traceUsed && strcmp( traceKey[ i ], key ) != 0; i++ )
+        ;
+    if ( i == traceUsed )
+    {
+        if ( traceUsed == TRACE_KEYS )
+            i = TRACE_KEYS - 1;   // full: lump the rest into the last entry
+        else
+        {
+            strcpy( traceKey[ i ], key );
+            traceCount[ i ] = 0;
+            traceUsed++;
+        }
+    }
+    traceCount[ i ]++;
+
+    if ( GetTickCount( ) - traceLastWrite > 2000 )
+    {
+        traceLastWrite = GetTickCount( );
+        LfbTraceWrite( );
+    }
+}
