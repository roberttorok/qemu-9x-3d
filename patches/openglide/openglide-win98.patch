+//**************************************************************
+//*            OpenGLide - Glide to OpenGL Wrapper
+//*                  Glide 3 (glide3x.dll) layer
+//*
+//*  glide3x.dll is built from the same sources as glide2x.dll plus
+//*  this file. Glide 3 kept most of the Glide 2 functions as they were;
+//*  Glide3x.def exports those directly. The functions here are the ones
+//*  that changed:
+//*   - vertices: any layout the game describes with grVertexLayout,
+//*     in window or clip coordinates (grCoordinateSpace, grViewport,
+//*     grDepthRange); converted here to OpenGLide's GrVertex.
+//*   - strips, fans and vertex arrays (grDrawVertexArray...).
+//*   - LOD, aspect ratio and texture base range are log2 values in
+//*     Glide 3 (GR_LOD_LOG2_256 = 8), counted the other way in Glide 2
+//*     (GR_LOD_256 = 0).
+//*   - the texture table calls lost their TMU argument,
+//*     grSstWinOpen returns a context, grSstWinClose takes one.
+//*   - new queries: grGet, grGetString, grQueryResolutions, grReset,
+//*     grGetProcAddress.
+//*  Values and behaviour follow 3dfx's Voodoo2 Glide 3 source
+//*  (glide3x/cvg/glide3/src: distrip.c, gdraw.c, diget.c).
+//**************************************************************
+
+#include <math.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "GlOgl.h"
+#include "GLRender.h"
+
+// ---- Glide 3 constants (glide.h of Glide 3.x) that differ from Glide 2 ----
+
+#define G3_PARAM_XY        0x01
+#define G3_PARAM_Z         0x02
+#define G3_PARAM_W         0x03
+#define G3_PARAM_Q         0x04
+#define G3_PARAM_FOG_EXT   0x05
+#define G3_PARAM_A         0x10
+#define G3_PARAM_RGB       0x20
+#define G3_PARAM_PARGB     0x30
+#define G3_PARAM_ST0       0x40
+#define G3_PARAM_ST1       0x41
+#define G3_PARAM_ST2       0x42
+#define G3_PARAM_Q0        0x50
+#define G3_PARAM_Q1        0x51
+#define G3_PARAM_Q2        0x52
+#define G3_PARAM_ENABLE    0x01
+
+#define G3_POINTS                   0
+#define G3_LINE_STRIP               1
+#define G3_LINES                    2
+#define G3_POLYGON                  3
+#define G3_TRIANGLE_STRIP           4
+#define G3_TRIANGLE_FAN             5
+#define G3_TRIANGLES                6
+#define G3_TRIANGLE_STRIP_CONTINUE  7
+#define G3_TRIANGLE_FAN_CONTINUE    8
+
+#define G3_WINDOW_COORDS   0x00
+#define G3_CLIP_COORDS     0x01
+
+#define G3_AA_ORDERED            0x01
+#define G3_ALLOW_MIPMAP_DITHER   0x02
+#define G3_PASSTHRU              0x03
+#define G3_SHAMELESS_PLUG        0x04
+#define G3_VIDEO_SMOOTHING       0x05
+
+#define G3_FOG_DISABLE                    0x0
+#define G3_FOG_WITH_TABLE_ON_FOGCOORD_EXT 0x1
+#define G3_FOG_WITH_TABLE_ON_Q            0x2
+#define G3_FOG_WITH_ITERATED_Z            0x3
+#define G3_FOG_WITH_ITERATED_ALPHA_EXT    0x4
+
+#define G3_TEXTABLE_PALETTE_6666_EXT 0x3
+
+// grGet
+#define G3_BITS_DEPTH                   0x01
+#define G3_BITS_RGBA                    0x02
+#define G3_FIFO_FULLNESS                0x03
+#define G3_FOG_TABLE_ENTRIES            0x04
+#define G3_GAMMA_TABLE_ENTRIES          0x05
+#define G3_GLIDE_STATE_SIZE             0x06
+#define G3_GLIDE_VERTEXLAYOUT_SIZE      0x07
+#define G3_IS_BUSY                      0x08
+#define G3_LFB_PIXEL_PIPE               0x09
+#define G3_MAX_TEXTURE_SIZE             0x0a
+#define G3_MAX_TEXTURE_ASPECT_RATIO     0x0b
+#define G3_MEMORY_FB                    0x0c
+#define G3_MEMORY_TMU                   0x0d
+#define G3_MEMORY_UMA                   0x0e
+#define G3_NUM_BOARDS                   0x0f
+#define G3_NON_POWER_OF_TWO_TEXTURES    0x10
+#define G3_NUM_FB                       0x11
+#define G3_NUM_SWAP_HISTORY_BUFFER      0x12
+#define G3_NUM_TMU                      0x13
+#define G3_PENDING_BUFFERSWAPS          0x14
+#define G3_REVISION_FB                  0x15
+#define G3_REVISION_TMU                 0x16
+#define G3_STATS_LINES                  0x17
+#define G3_STATS_PIXELS_AFUNC_FAIL      0x18
+#define G3_STATS_PIXELS_CHROMA_FAIL     0x19
+#define G3_STATS_PIXELS_DEPTHFUNC_FAIL  0x1a
+#define G3_STATS_PIXELS_IN              0x1b
+#define G3_STATS_PIXELS_OUT             0x1c
+#define G3_STATS_POINTS                 0x1e
+#define G3_STATS_TRIANGLES_IN           0x1f
+#define G3_STATS_TRIANGLES_OUT          0x20
+#define G3_SWAP_HISTORY                 0x22
+#define G3_SUPPORTS_PASSTHRU            0x23
+#define G3_TEXTURE_ALIGN                0x24
+#define G3_VIDEO_POSITION               0x25
+#define G3_VIEWPORT                     0x26
+#define G3_WDEPTH_MIN_MAX               0x27
+#define G3_ZDEPTH_MIN_MAX               0x28
+#define G3_BITS_GAMMA                   0x2a
+
+// grGetString
+#define G3_EXTENSION   0xa0
+#define G3_HARDWARE    0xa1
+#define G3_RENDERER    0xa2
+#define G3_VENDOR      0xa3
+#define G3_VERSION     0xa4
+
+#define G3_QUERY_ANY   -1
+
+// Glide 3's GrTexInfo has the same layout as Glide 2's, with log2 values.
+struct G3TexInfo
+{
+    FxI32 smallLodLog2;
+    FxI32 largeLodLog2;
+    FxI32 aspectRatioLog2;
+    FxI32 format;
+    void *data;
+};
+
+struct G3Resolution
+{
+    FxI32 resolution;
+    FxI32 refresh;
+    int   numColorBuffers;
+    int   numAuxBuffers;
+};
+
+typedef int ( FX_CALL *G3Proc )( );
+
+// ---- Conversions ----
+
+static inline GrLOD_t Lod2( FxI32 lodLog2 )               { return (GrLOD_t)( GR_LOD_1 - lodLog2 ); }
+static inline GrAspectRatio_t Aspect2( FxI32 aspectLog2 ) { return (GrAspectRatio_t)( GR_ASPECT_1x1 - aspectLog2 ); }
+static inline FxI32 LodLog2( GrLOD_t lod )                { return GR_LOD_1 - lod; }
+static inline FxI32 AspectLog2( GrAspectRatio_t aspect )  { return GR_ASPECT_1x1 - aspect; }
+
+static void TexInfo2( const G3TexInfo *in, GrTexInfo *out )
+{
+    out->smallLod    = Lod2( in->smallLodLog2 );
+    out->largeLod    = Lod2( in->largeLodLog2 );
+    out->aspectRatio = Aspect2( in->aspectRatioLog2 );
+    out->format      = in->format;
+    out->data        = in->data;
+}
+
+// ---- State that Glide 2 doesn't have ----
+
+struct G3Param
+{
+    FxI32 offset;
+    FxU32 mode;
+};
+
+struct G3VertexLayout
+{
+    G3Param xy, z, w, q, fog, a, rgb, pargb, st0, st1, q0, q1;
+};
+
+struct G3Extra
+{
+    FxU32 coordSpace;
+    float vpOx, vpOy, vpHWidth, vpHHeight;
+    float depthNear, depthFar;
+    float sScale, tScale;       // clip coordinates: texture size of TMU0's source
+};
+
+static G3VertexLayout Layout;
+static G3Extra        Extra;
+
+static void SetViewport( FxI32 x, FxI32 y, FxI32 width, FxI32 height )
+{
+    Extra.vpOx      = x + width * 0.5f;
+    Extra.vpOy      = y + height * 0.5f;
+    Extra.vpHWidth  = width * 0.5f;
+    Extra.vpHHeight = height * 0.5f;
+}
+
+static void ResetExtra( void )
+{
+    memset( &Layout, 0, sizeof( Layout ) );
+    memset( &Extra, 0, sizeof( Extra ) );
+    Extra.coordSpace = G3_WINDOW_COORDS;
+    Extra.depthNear  = 0.0f;
+    Extra.depthFar   = 1.0f;
+    Extra.sScale = Extra.tScale = 256.0f;
+    SetViewport( 0, 0, Glide.WindowWidth, Glide.WindowHeight );
+}
+
+// Glide 3 always has a separate texture w (q0, or q) besides the depth/fog
+// w (q, or w): render with TMU0's own w, as Glide 2 does with this hint.
+static void SetW3Hint( void )
+{
+    grHints( GR_HINT_STWHINT, GR_STWHINT_W_DIFF_TMU0 );
+}
+
+#define VF( v, p ) ( *(const float *)( (const char *)( v ) + Layout.p.offset ) )
+#define ON( p )    ( Layout.p.mode == G3_PARAM_ENABLE )
+
+// One Glide 3 vertex to a Glide 2 one.
+static void Convert( const void *src, GrVertex *dst )
+{
+    dst->z = 0.0f;
+    dst->r = dst->g = dst->b = dst->a = 0.0f;
+
+    float colorScale = 1.0f;
+    if ( Extra.coordSpace == G3_CLIP_COORDS )
+    {
+        colorScale = 255.0f;    // clip coordinates take colours as 0..1
+    }
+
+    if ( ON( pargb ) )
+    {
+        const FxU32 c = *(const FxU32 *)( (const char *)src + Layout.pargb.offset );
+        dst->a = (float)( c >> 24 );
+        dst->r = (float)( ( c >> 16 ) & 0xff );
+        dst->g = (float)( ( c >> 8 ) & 0xff );
+        dst->b = (float)( c & 0xff );
+    }
+    else
+    {
+        if ( ON( rgb ) )
+        {
+            const float *rgb = (const float *)( (const char *)src + Layout.rgb.offset );
+            dst->r = rgb[ 0 ] * colorScale;
+            dst->g = rgb[ 1 ] * colorScale;
+            dst->b = rgb[ 2 ] * colorScale;
+        }
+        if ( ON( a ) )
+        {
+            dst->a = VF( src, a ) * colorScale;
+        }
+    }
+
+    float s = 0.0f, t = 0.0f;
+    if ( ON( st0 ) )
+    {
+        s = VF( src, st0 );
+        t = *(const float *)( (const char *)src + Layout.st0.offset + 4 );
+    }
+
+    if ( Extra.coordSpace == G3_CLIP_COORDS )
+    {
+        // gdraw.c: x * (1/w) * half width + centre, the same for y and z;
+        // the w's going to the hardware are q * (1/w), or 1/w.
+        const float w   = ON( w ) ? VF( src, w ) : 1.0f;
+        const float oow = ( w != 0.0f ) ? 1.0f / w : 1.0f;
+        dst->x   = VF( src, xy ) * oow * Extra.vpHWidth + Extra.vpOx;
+        dst->y   = *(const float *)( (const char *)src + Layout.xy.offset + 4 ) * oow * Extra.vpHHeight + Extra.vpOy;
+        dst->ooz = ON( z ) ? VF( src, z ) * oow * ( Extra.depthFar - Extra.depthNear ) * 0.5f * 65535.0f
+                             + ( Extra.depthFar + Extra.depthNear ) * 0.5f * 65535.0f
+                           : 0.0f;
+        dst->oow = ON( q ) ? VF( src, q ) * oow : oow;
+        dst->tmuvtx[ 0 ].oow = ON( q0 ) ? VF( src, q0 ) * oow : oow;
+        dst->tmuvtx[ 0 ].sow = s * oow * Extra.sScale;
+        dst->tmuvtx[ 0 ].tow = t * oow * Extra.tScale;
+    }
+    else
+    {
+        // Window coordinates: as Glide 2 had them. The hardware's w is q
+        // (W is only used in clip coordinates); TMU0's is q0, else q.
+        dst->x   = VF( src, xy );
+        dst->y   = *(const float *)( (const char *)src + Layout.xy.offset + 4 );
+        dst->ooz = ON( z ) ? VF( src, z ) : 0.0f;
+        const float q = ON( q ) ? VF( src, q ) : ( ON( w ) ? VF( src, w ) : 1.0f );
+        dst->oow = q;
+        dst->tmuvtx[ 0 ].oow = ON( q0 ) ? VF( src, q0 ) : q;
+        dst->tmuvtx[ 0 ].sow = s;
+        dst->tmuvtx[ 0 ].tow = t;
+    }
+
+    for ( int i = 1; i < GLIDE_NUM_TMU; i++ )
+    {
+        dst->tmuvtx[ i ] = dst->tmuvtx[ 0 ];
+    }
+}
+
+// ---- Drawing ----
+
+extern "C" {
+
+FX_ENTRY void FX_CALL
+g3_grVertexLayout( FxU32 param, FxI32 offset, FxU32 mode )
+{
+#ifdef OGL_PARTDONE
+    GlideMsg( "grVertexLayout( 0x%x, %d, %u )\n", param, offset, mode );
+#endif
+    G3Param *p = NULL;
+    switch ( param )
+    {
+    case G3_PARAM_XY:      p = &Layout.xy;    break;
+    case G3_PARAM_Z:       p = &Layout.z;     break;
+    case G3_PARAM_W:       p = &Layout.w;     break;
+    case G3_PARAM_Q:       p = &Layout.q;     break;
+    case G3_PARAM_FOG_EXT: p = &Layout.fog;   break;
+    case G3_PARAM_A:       p = &Layout.a;     break;
+    case G3_PARAM_RGB:     p = &Layout.rgb;   break;
+    case G3_PARAM_PARGB:   p = &Layout.pargb; break;
+    case G3_PARAM_ST0:     p = &Layout.st0;   break;
+    case G3_PARAM_ST1:     p = &Layout.st1;   break;
+    case G3_PARAM_Q0:      p = &Layout.q0;    break;
+    case G3_PARAM_Q1:      p = &Layout.q1;    break;
+    }
+    if ( p )
+    {
+        p->offset = offset;
+        p->mode   = mode;
+        // As in 3dfx's library: float colour and packed colour exclude each other.
+        if ( mode == G3_PARAM_ENABLE )
+        {
+            if ( p == &Layout.pargb )
+            {
+                Layout.rgb.mode = Layout.a.mode = 0;
+            }
+            else if ( p == &Layout.rgb || p == &Layout.a )
+            {
+                Layout.pargb.mode = 0;
+            }
+        }
+    }
+}
+
+FX_ENTRY void FX_CALL
+g3_grDrawPoint( const void *pt )
+{
+    GrVertex v;
+    Convert( pt, &v );
+    grDrawPoint( &v );
+}
+
+FX_ENTRY void FX_CALL
+g3_grDrawLine( const void *a, const void *b )
+{
+    GrVertex va, vb;
+    Convert( a, &va );
+    Convert( b, &vb );
+    grDrawLine( &va, &vb );
+}
+
+FX_ENTRY void FX_CALL
+g3_grDrawTriangle( const void *a, const void *b, const void *c )
+{
+    GrVertex va, vb, vc;
+    Convert( a, &va );
+    Convert( b, &vb );
+    Convert( c, &vc );
+    grDrawTriangle( &va, &vb, &vc );
+}
+
+FX_ENTRY void FX_CALL
+g3_grAADrawTriangle( const void *a, const void *b, const void *c,
+                     FxBool ab_antialias, FxBool bc_antialias, FxBool ca_antialias )
+{
+    GrVertex va, vb, vc;
+    Convert( a, &va );
+    Convert( b, &vb );
+    Convert( c, &vc );
+    grAADrawTriangle( &va, &vb, &vc, ab_antialias, bc_antialias, ca_antialias );
+}
+
+// What a _CONTINUE strip or fan carries on from.
+static GrVertex StripPrev[ 2 ];     // strip: the last two vertices; fan: centre and last
+static FxU32    StripCount;         // triangles drawn so far in this strip (for winding)
+
+// Converted vertices of one grDrawVertexArray call. A plain malloc buffer:
+// a C++ exception (std::vector's bad_alloc, say) can't even be thrown in
+// this DLL on Windows 98 (__cxa_throw faults), so no C++ library here.
+static GrVertex *ArrayBuf;
+static FxU32     ArrayBufSize;
+
+static void DrawArray( FxU32 mode, FxU32 count, const void *base, FxU32 stride, bool indirect )
+{
+    if ( count == 0 )
+    {
+        return;
+    }
+    if ( count > ArrayBufSize )
+    {
+        GrVertex *grown = (GrVertex *)realloc( ArrayBuf, count * sizeof( GrVertex ) );
+        if ( !grown )
+        {
+            return;
+        }
+        ArrayBuf     = grown;
+        ArrayBufSize = count;
+    }
+    GrVertex *v = ArrayBuf;
+    for ( FxU32 i = 0; i < count; i++ )
+    {
+        const void *src = indirect ? ( (const void * const *)base )[ i ]
+                                   : (const void *)( (const char *)base + i * stride );
+        Convert( src, &v[ i ] );
+    }
+
+    switch ( mode )
+    {
+    case G3_POINTS:
+        for ( FxU32 i = 0; i < count; i++ )
+        {
+            grDrawPoint( &v[ i ] );
+        }
+        break;
+
+    case G3_LINE_STRIP:
+        for ( FxU32 i = 0; i + 1 < count; i++ )
+        {
+            grDrawLine( &v[ i ], &v[ i + 1 ] );
+        }
+        break;
+
+    case G3_LINES:
+        for ( FxU32 i = 0; i + 1 < count; i += 2 )
+        {
+            grDrawLine( &v[ i ], &v[ i + 1 ] );
+        }
+        break;
+
+    case G3_TRIANGLES:
+        for ( FxU32 i = 0; i + 2 < count; i += 3 )
+        {
+            grDrawTriangle( &v[ i ], &v[ i + 1 ], &v[ i + 2 ] );
+        }
+        break;
+
+    case G3_POLYGON:
+    case G3_TRIANGLE_FAN:
+        for ( FxU32 i = 1; i + 1 < count; i++ )
+        {
+            grDrawTriangle( &v[ 0 ], &v[ i ], &v[ i + 1 ] );
+        }
+        if ( count >= 2 )
+        {
+            StripPrev[ 0 ] = v[ 0 ];
+            StripPrev[ 1 ] = v[ count - 1 ];
+        }
+        break;
+
+    case G3_TRIANGLE_FAN_CONTINUE:
+        for ( FxU32 i = 0; i < count; i++ )
+        {
+            grDrawTriangle( &StripPrev[ 0 ], &StripPrev[ 1 ], &v[ i ] );
+            StripPrev[ 1 ] = v[ i ];
+        }
+        break;
+
+    case G3_TRIANGLE_STRIP:
+        StripCount = 0;
+        for ( FxU32 i = 0; i + 2 < count; i++ )
+        {
+            // Every other triangle swaps its first two vertices, so they
+            // all keep the same winding (for culling).
+            if ( StripCount++ & 1 )
+            {
+                grDrawTriangle( &v[ i + 1 ], &v[ i ], &v[ i + 2 ] );
+            }
+            else
+            {
+                grDrawTriangle( &v[ i ], &v[ i + 1 ], &v[ i + 2 ] );
+            }
+        }
+        if ( count >= 2 )
+        {
+            StripPrev[ 0 ] = v[ count - 2 ];
+            StripPrev[ 1 ] = v[ count - 1 ];
+        }
+        break;
+
+    case G3_TRIANGLE_STRIP_CONTINUE:
+        for ( FxU32 i = 0; i < count; i++ )
+        {
+            if ( StripCount++ & 1 )
+            {
+                grDrawTriangle( &StripPrev[ 1 ], &StripPrev[ 0 ], &v[ i ] );
+            }
+            else
+            {
+                grDrawTriangle( &StripPrev[ 0 ], &StripPrev[ 1 ], &v[ i ] );
+            }
+            StripPrev[ 0 ] = StripPrev[ 1 ];
+            StripPrev[ 1 ] = v[ i ];
+        }
+        break;
+    }
+}
