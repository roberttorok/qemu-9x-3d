+// Glide 3's 6666 palette (Voodoo3 and later) as an ordinary 8888 one.
+static void Palette6666( const FxU32 *in, FxU32 *out, int start, int end )
+{
+    for ( int i = start; i <= end; i++ )
+    {
+        const FxU32 c = in[ i ];
+        const FxU32 a = ( c >> 18 ) & 0x3f, r = ( c >> 12 ) & 0x3f, g = ( c >> 6 ) & 0x3f, b = c & 0x3f;
+        out[ i ] = ( ( ( a << 2 ) | ( a >> 4 ) ) << 24 ) | ( ( ( r << 2 ) | ( r >> 4 ) ) << 16 )
+                 | ( ( ( g << 2 ) | ( g >> 4 ) ) << 8 ) | ( ( b << 2 ) | ( b >> 4 ) );
+    }
+}
+
+FX_ENTRY void FX_CALL
+g3_grTexDownloadTable( FxU32 type, void *data )
+{
+    if ( type == G3_TEXTABLE_PALETTE_6666_EXT )
+    {
+        FxU32 pal[ 256 ];
+        Palette6666( (const FxU32 *)data, pal, 0, 255 );
+        grTexDownloadTable( GR_TMU0, GR_TEXTABLE_PALETTE, pal );
+        return;
+    }
+    grTexDownloadTable( GR_TMU0, type, data );
+}
+
+FX_ENTRY void FX_CALL
+g3_grTexDownloadTablePartial( FxU32 type, void *data, int start, int end )
+{
+    if ( type == G3_TEXTABLE_PALETTE_6666_EXT )
+    {
+        FxU32 pal[ 256 ];
+        if ( start < 0 ) start = 0;
+        if ( end > 255 ) end = 255;
+        Palette6666( (const FxU32 *)data, pal, start, end );
+        grTexDownloadTablePartial( GR_TMU0, GR_TEXTABLE_PALETTE, pal, start, end );
+        return;
+    }
+    grTexDownloadTablePartial( GR_TMU0, type, data, start, end );
+}
