+FX_ENTRY void FX_CALL
+g3_guFogGenerateExp2( GrFog_t *fogtable, float density )
+{
+    for ( int i = 0; i < GR_FOG_TABLE_SIZE; i++ )
+    {
+        const float dp = density * guFogTableIndexToW( i );
+        float f = ( 1.0f - (float)exp( -dp * dp ) ) * 255.0f;
+        if ( f > 255.0f ) f = 255.0f;
+        if ( f < 0.0f )   f = 0.0f;
+        fogtable[ i ] = (GrFog_t)f;
+    }
+}
