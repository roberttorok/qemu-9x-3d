+// GLU is not used: Windows 98's glu32.dll would bind to whichever opengl32.dll was
+// loaded first. Level 0 is already uploaded, and Glide textures are powers of two,
+// so the host's glGenerateMipmap does what gluBuild2DMipmaps did.
+static void OGLGenerateMipmap( void )
+{
+    static void ( APIENTRY *generate )( GLenum ) = NULL;
+    static bool looked = false;
+    if ( !looked )
+    {
+        *(PROC *)&generate = wglGetProcAddress( "glGenerateMipmap" );
+        looked = true;
+    }
+    if ( generate )
+        generate( GL_TEXTURE_2D );
+}
+
 
