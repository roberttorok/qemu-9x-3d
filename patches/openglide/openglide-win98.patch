+//*************************************************
+//* Voodoo-style front and back buffers
+//*
+//* A Voodoo's two buffers keep their contents and exchange on a swap, and games
+//* rely on it: they redraw only what changed, or draw straight into the front
+//* buffer. A window's OpenGL back buffer is undefined after a swap, and SharedGL
+//* only shows a picture on a swap, so render into two private colour buffers and
+//* copy the logical front one to the window to show it.
+//*
+//* Drawing into the front buffer would show every primitive; that is presented at
+//* most once a frame (BufferEmuFrontDirty), since each present copies the whole
+//* picture out of the VM.
+//*************************************************
+#define EMU_FRAMEBUFFER          0x8D40
+#define EMU_READ_FRAMEBUFFER     0x8CA8
+#define EMU_DRAW_FRAMEBUFFER     0x8CA9
+#define EMU_RENDERBUFFER         0x8D41
+#define EMU_COLOR_ATTACHMENT0    0x8CE0
+#define EMU_DEPTH_ATTACHMENT     0x8D00
+#define EMU_DEPTH_COMPONENT24    0x81A6
+#define EMU_FRAMEBUFFER_COMPLETE 0x8CD5
+#define EMU_FRONT_INTERVAL_MS    16
+
