+void BufferEmuInit( void )
+{
+#define EMU_GET( v, n ) *(PROC *)&v = wglGetProcAddress( n )
+    EMU_GET( pGenFramebuffers, "glGenFramebuffers" );
+    EMU_GET( pBindFramebuffer, "glBindFramebuffer" );
+    EMU_GET( pGenRenderbuffers, "glGenRenderbuffers" );
+    EMU_GET( pBindRenderbuffer, "glBindRenderbuffer" );
+    EMU_GET( pRenderbufferStorage, "glRenderbufferStorage" );
+    EMU_GET( pFramebufferRenderbuffer, "glFramebufferRenderbuffer" );
+    EMU_GET( pCheckFramebufferStatus, "glCheckFramebufferStatus" );
+    EMU_GET( pBlitFramebuffer, "glBlitFramebuffer" );
+    EMU_GET( pDeleteFramebuffers, "glDeleteFramebuffers" );
+    EMU_GET( pDeleteRenderbuffers, "glDeleteRenderbuffers" );
+#undef EMU_GET
+    if ( !pGenFramebuffers || !pBindFramebuffer || !pGenRenderbuffers || !pBindRenderbuffer ||
+         !pRenderbufferStorage || !pFramebufferRenderbuffer || !pCheckFramebufferStatus ||
+         !pBlitFramebuffer || !pDeleteFramebuffers || !pDeleteRenderbuffers )
+    {
+        GlideMsg( "No framebuffer objects: using the window's buffers.\n" );
+        return;
+    }
+    int w = OpenGL.WindowWidth, h = OpenGL.WindowHeight, i;
+    pGenFramebuffers( 1, &emuFbo );
+    pBindFramebuffer( EMU_FRAMEBUFFER, emuFbo );
+    pGenRenderbuffers( 3, emuRb );
+    for ( i = 0; i < 3; i++ )
+    {
+        pBindRenderbuffer( EMU_RENDERBUFFER, emuRb[ i ] );
+        pRenderbufferStorage( EMU_RENDERBUFFER, i < 2 ? GL_RGBA8 : EMU_DEPTH_COMPONENT24, w, h );
