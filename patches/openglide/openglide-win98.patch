+// The 3DF file header has LODs and aspect ratio too.
+static void Header3( Gu3dfInfo *info )
+{
+    info->header.small_lod    = LodLog2( info->header.small_lod );
+    info->header.large_lod    = LodLog2( info->header.large_lod );
+    info->header.aspect_ratio = AspectLog2( info->header.aspect_ratio );
+}
