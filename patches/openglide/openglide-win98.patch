+// The modes 3dfx's Voodoo2 library offers (diget.c, _grResolutionRefresh):
+// the screen sizes and refresh rates a Voodoo2 could show. OpenGLide draws
+// any of them; games pick one from this list, and some ask for 75 or 85 Hz.
+static const struct { FxI32 resolution; FxU32 refreshMask; } VoodooModes[] =
+{
+    // refresh bits: 1 << GR_REFRESH_xxHz (60=0 70=1 72=2 75=3 85=7 120=8)
+    { GR_RESOLUTION_512x384,  ( 1 << 0 ) | ( 1 << 2 ) | ( 1 << 3 ) | ( 1 << 7 ) | ( 1 << 8 ) },
+    { GR_RESOLUTION_640x400,  ( 1 << 1 ) | ( 1 << 7 ) | ( 1 << 8 ) },
+    { GR_RESOLUTION_640x480,  ( 1 << 0 ) | ( 1 << 3 ) | ( 1 << 7 ) | ( 1 << 8 ) },
+    { GR_RESOLUTION_800x600,  ( 1 << 0 ) | ( 1 << 3 ) | ( 1 << 7 ) | ( 1 << 8 ) },
+    { GR_RESOLUTION_960x720,  ( 1 << 0 ) | ( 1 << 3 ) | ( 1 << 7 ) },
+    { GR_RESOLUTION_856x480,  ( 1 << 0 ) },
+    { GR_RESOLUTION_1024x768, ( 1 << 0 ) | ( 1 << 3 ) | ( 1 << 7 ) },
+};
+
+FX_ENTRY FxI32 FX_CALL
+g3_grQueryResolutions( const G3Resolution *resTemplate, G3Resolution *output )
+{
+    FxI32 size = 0;
+    for ( unsigned i = 0; i < sizeof( VoodooModes ) / sizeof( VoodooModes[ 0 ] ); i++ )
+    {
+        const FxI32 res = VoodooModes[ i ].resolution;
+        if ( resTemplate->resolution != G3_QUERY_ANY && resTemplate->resolution != res )
+            continue;
+        for ( FxI32 ref = GR_REFRESH_60Hz; ref <= GR_REFRESH_120Hz; ref++ )
+        {
+            if ( !( VoodooModes[ i ].refreshMask & ( 1u << ref ) ) )
+                continue;
+            if ( resTemplate->refresh != G3_QUERY_ANY && resTemplate->refresh != ref )
+                continue;
+            for ( int col = 2; col <= 3; col++ )
+            {
+                if ( resTemplate->numColorBuffers != G3_QUERY_ANY && resTemplate->numColorBuffers != col )
+                    continue;
+                for ( int aux = 0; aux <= 1; aux++ )
+                {
+                    if ( resTemplate->numAuxBuffers != G3_QUERY_ANY && resTemplate->numAuxBuffers != aux )
+                        continue;
+                    size += sizeof( G3Resolution );
+                    if ( output != NULL )
+                    {
+                        output->resolution      = res;
+                        output->refresh         = ref;
+                        output->numColorBuffers = col;
+                        output->numAuxBuffers   = aux;
+                        output++;
+                    }
+                }
+            }
+        }
+    }
+#ifdef OGL_PARTDONE
+    GlideMsg( "grQueryResolutions( %d, %d, %d, %d ) = %d bytes\n", resTemplate->resolution, resTemplate->refresh,
+              resTemplate->numColorBuffers, resTemplate->numAuxBuffers, size );
+#endif
+    return size;
+}
