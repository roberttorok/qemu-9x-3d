+FX_ENTRY FxU32 FX_CALL
+g3_grGet( FxU32 pname, FxU32 plength, FxI32 *params )
+{
+#ifdef OGL_PARTDONE
+    GlideMsg( "grGet( 0x%x, %u )\n", pname, plength );
+#endif
+    if ( params == NULL )
+    {
+        return 0;
+    }
+    switch ( pname )
+    {
+    case G3_BITS_DEPTH:                 return ParamI( plength, params, 16 );
+    case G3_BITS_RGBA:
+        if ( plength != 16 ) return 0;
+        params[ 0 ] = 5; params[ 1 ] = 6; params[ 2 ] = 5; params[ 3 ] = 0;
+        return 16;
+    case G3_FIFO_FULLNESS:
+        if ( plength != 8 ) return 0;
+        params[ 0 ] = 0; params[ 1 ] = 0;
+        return 8;
+    case G3_FOG_TABLE_ENTRIES:          return ParamI( plength, params, GR_FOG_TABLE_SIZE );
+    case G3_GAMMA_TABLE_ENTRIES:        return ParamI( plength, params, 32 );
+    case G3_BITS_GAMMA:                 return ParamI( plength, params, 8 );
+    case G3_GLIDE_STATE_SIZE:           return ParamI( plength, params, sizeof( G3State ) );
+    case G3_GLIDE_VERTEXLAYOUT_SIZE:    return ParamI( plength, params, sizeof( G3VertexLayout ) );
+    case G3_IS_BUSY:                    return ParamI( plength, params, FXFALSE );
+    case G3_LFB_PIXEL_PIPE:             return ParamI( plength, params, FXFALSE );
+    case G3_MAX_TEXTURE_SIZE:           return ParamI( plength, params, 256 );
+    case G3_MAX_TEXTURE_ASPECT_RATIO:   return ParamI( plength, params, 3 );
+    case G3_MEMORY_FB:                  return ParamI( plength, params, UserConfig.FrameBufferMemorySize << 20 );
+    case G3_MEMORY_TMU:                 return ParamI( plength, params, UserConfig.TextureMemorySize << 20 );
+    case G3_MEMORY_UMA:                 return ParamI( plength, params, 0 );
+    case G3_NUM_BOARDS:                 return ParamI( plength, params, 1 );
+    case G3_NON_POWER_OF_TWO_TEXTURES:  return ParamI( plength, params, FXFALSE );
+    case G3_NUM_FB:                     return ParamI( plength, params, 1 );
+    case G3_NUM_SWAP_HISTORY_BUFFER:    return ParamI( plength, params, 0 );
+    case G3_NUM_TMU:                    return ParamI( plength, params, 1 );
+    case G3_PENDING_BUFFERSWAPS:        return ParamI( plength, params, grBufferNumPending( ) );
+    case G3_REVISION_FB:                return ParamI( plength, params, 2 );
+    case G3_REVISION_TMU:               return ParamI( plength, params, 1 );
+    case G3_STATS_LINES:
+    case G3_STATS_PIXELS_AFUNC_FAIL:
+    case G3_STATS_PIXELS_CHROMA_FAIL:
+    case G3_STATS_PIXELS_DEPTHFUNC_FAIL:
+    case G3_STATS_PIXELS_IN:
+    case G3_STATS_PIXELS_OUT:
+    case G3_STATS_POINTS:
+    case G3_STATS_TRIANGLES_IN:
+    case G3_STATS_TRIANGLES_OUT:        return ParamI( plength, params, 0 );
+    case G3_SWAP_HISTORY:
+        if ( plength != 32 ) return 0;
+        memset( params, 0, 32 );
+        return 32;
+    case G3_SUPPORTS_PASSTHRU:          return ParamI( plength, params, FXFALSE );
+    case G3_TEXTURE_ALIGN:              return ParamI( plength, params, 8 );
+    case G3_VIDEO_POSITION:
+        if ( plength != 8 ) return 0;
+        params[ 0 ] = 0; params[ 1 ] = 0;
+        return 8;
+    case G3_VIEWPORT:
+        if ( plength != 16 ) return 0;
+        params[ 0 ] = (FxI32)( Extra.vpOx - Extra.vpHWidth );
+        params[ 1 ] = (FxI32)( Extra.vpOy - Extra.vpHHeight );
+        params[ 2 ] = (FxI32)( Extra.vpHWidth * 2.0f );
+        params[ 3 ] = (FxI32)( Extra.vpHHeight * 2.0f );
+        return 16;
+    case G3_WDEPTH_MIN_MAX:
+        if ( plength != 8 ) return 0;
+        params[ 0 ] = GR_WDEPTHVALUE_NEAREST; params[ 1 ] = GR_WDEPTHVALUE_FARTHEST;
+        return 8;
+    case G3_ZDEPTH_MIN_MAX:
+        if ( plength != 8 ) return 0;
+        params[ 0 ] = GR_ZDEPTHVALUE_NEAREST; params[ 1 ] = GR_ZDEPTHVALUE_FARTHEST;
+        return 8;
+    }
+#ifdef OGL_NOTDONE
+    GlideMsg( "grGet: unknown pname 0x%x\n", pname );
+#endif
+    return 0;
+}
