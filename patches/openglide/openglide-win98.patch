+        // off: World Cup 98's players lost parts of their textures that way. So the
+        // keyed and unkeyed copies are cached apart, by a key that is never 0 (0
+        // matches any copy). New texture data still wipes both: downloads wipe with 0.
+        test_hash = m_chromakey_mode ? ( 0x80000000u | m_chromakey_value_565 ) : 0x40000000u;
