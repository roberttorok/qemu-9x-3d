--- a/TexDB.cpp
+++ b/TexDB.cpp
@@ -187,13 +187,63 @@ void TexDB::Clear( void )
 
 // TexDB::Record Class implementation
 
+// Texture names are recycled instead of deleted and generated again. With SharedGL every
+// glGenTextures is a round trip to the host, and games that stream textures (Unreal
+// re-downloads dozens per frame, more while turning) paid one per texture. A recycled
+// texture keeps its GL object: the new texture's glTexImage2D replaces the contents, and
+// PGTexture sets wrap and filters on every new texture. The names are never deleted, so
+// glGenTextures can't hand them to anyone else (e.g. the LFB texture).
+static GLuint *s_freeNames = NULL;
+static int     s_freeCount = 0;
+static int     s_freeSize  = 0;
+
+static GLuint TexNameGet( void )
+{
+   if ( s_freeCount > 0 )
+   {
+      return s_freeNames[ --s_freeCount ];
+   }
+
+   GLuint name;
+   glGenTextures( 1, &name );
+   return name;
+}
+
+static void TexNamePut( GLuint name )
+{
+   if ( s_freeCount == s_freeSize )
+   {
+      int     size  = s_freeSize ? s_freeSize * 2 : 256;
+      GLuint *names = new GLuint[ size ];
+      for ( int i = 0; i < s_freeCount; i++ )
+      {
+         names[ i ] = s_freeNames[ i ];
+      }
+      delete[] s_freeNames;
+      s_freeNames = names;
+      s_freeSize  = size;
+   }
+   s_freeNames[ s_freeCount++ ] = name;
+}
+
+// Delete the recycled names for real: before the GL context goes away (grSstWinClose),
+// so a new context doesn't inherit names it never generated.
+void TexNamePoolFlush( void )
+{
+   if ( s_freeCount > 0 )
+   {
+      glDeleteTextures( s_freeCount, s_freeNames );
+   }
+   s_freeCount = 0;
+}
+
 TexDB::Record::Record( bool two_tex )
 {
-   glGenTextures( 1, &texNum );
+   texNum = TexNameGet( );
 
    if ( two_tex )
    {
-         glGenTextures( 1, &tex2Num );
+         tex2Num = TexNameGet( );
    }
    else
    {
@@ -203,11 +253,11 @@ TexDB::Record::Record( bool two_tex )
 
