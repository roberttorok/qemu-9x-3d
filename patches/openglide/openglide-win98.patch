 {
-    return wglGetProcAddress(x);
+    ExtFn proc = (ExtFn)wglGetProcAddress(x);
+    size_t length = strlen(x);
+
+    if (!proc && length > 3 && length < 128 &&
+        (strcmp(x + length - 3, "EXT") == 0 || strcmp(x + length - 3, "ARB") == 0))
+    {
+        char core[128];
+        memcpy(core, x, length - 3);
+        core[length - 3] = '\0';
+        proc = (ExtFn)wglGetProcAddress(core);
+    }
+    return proc;
 }
 
