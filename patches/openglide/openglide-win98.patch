+    TexInfo2( info, &i2 );
+    if ( tmu == GR_TMU0 )
+    {
+        // gtex.c: the texture size clip coordinates' s and t (0..1) scale to.
+        const FxI32 a = info->aspectRatioLog2;
+        Extra.sScale = a >= 0 ? 256.0f : 256.0f / (float)( 1 << -a );
+        Extra.tScale = a <= 0 ? 256.0f : 256.0f / (float)( 1 << a );
+    }
+    grTexSource( tmu, startAddress, evenOdd, &i2 );
+}
