+}
+
+void BufferEmuClose( void )
+{
+    if ( !emuFbo )
+        return;
+    pBindFramebuffer( EMU_FRAMEBUFFER, 0 );
+    pDeleteFramebuffers( 1, &emuFbo );
+    pDeleteRenderbuffers( 3, emuRb );
+    emuFbo = 0;
+}
+
+// Show the logical front buffer in the window.
+void BufferEmuPresent( void )
+{
+    emuLastPresent = GetTickCount( );
+    if ( !emuFbo )
+    {
+        if ( Glide.State.RenderBuffer == GR_BUFFER_FRONTBUFFER )
+            glFlush( );
+        else
+            SwapBuffers( );
+        return;
+    }
+    GLboolean scissor = glIsEnabled( GL_SCISSOR_TEST );
+    GLint read;
+    int w = OpenGL.WindowWidth, h = OpenGL.WindowHeight;
+    glGetIntegerv( GL_READ_BUFFER, &read );
+    if ( scissor )
+        glDisable( GL_SCISSOR_TEST );
+    glReadBuffer( BufferEmuMap( GL_FRONT ) );
+    pBindFramebuffer( EMU_DRAW_FRAMEBUFFER, 0 );
+    pBlitFramebuffer( 0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST );
+    SwapBuffers( );
+    pBindFramebuffer( EMU_FRAMEBUFFER, emuFbo );
+    glReadBuffer( read );
+    if ( scissor )
+        glEnable( GL_SCISSOR_TEST );
+}
+
+// Something was drawn into the front buffer: show it, but not more than once a frame.
+void BufferEmuFrontDirty( void )
+{
+    if ( GetTickCount( ) - emuLastPresent >= EMU_FRONT_INTERVAL_MS )
+        BufferEmuPresent( );
+}
