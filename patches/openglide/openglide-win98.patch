+g3_gu3dfGetInfo( const char *filename, Gu3dfInfo *info )
+{
+    if ( !gu3dfGetInfo( filename, info ) )
+    {
+        return FXFALSE;
+    }
+    Header3( info );
+    return FXTRUE;
+}
+
+FX_ENTRY FxBool FX_CALL
+g3_gu3dfLoad( const char *filename, Gu3dfInfo *data )
+{
+    // gu3dfLoad reads the header again from the file, in Glide 2 values.
+    if ( !gu3dfLoad( filename, data ) )
+    {
+        return FXFALSE;
+    }
+    Header3( data );
+    return FXTRUE;
+}
