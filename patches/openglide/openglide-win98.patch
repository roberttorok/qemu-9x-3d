+            i < 2 ? EMU_COLOR_ATTACHMENT0 + i : EMU_DEPTH_ATTACHMENT, EMU_RENDERBUFFER, emuRb[ i ] );
+    }
+    if ( pCheckFramebufferStatus( EMU_FRAMEBUFFER ) != EMU_FRAMEBUFFER_COMPLETE )
+    {
+        GlideMsg( "Framebuffer incomplete: using the window's buffers.\n" );
+        BufferEmuClose( );
+        return;
+    }
+    emuBack = 0;
+    for ( i = 0; i < 2; i++ )
+    {
+        glDrawBuffer( EMU_COLOR_ATTACHMENT0 + i );
+        glClearColor( 0, 0, 0, 0 );
+        glClear( GL_COLOR_BUFFER_BIT );
+    }
+    glClear( GL_DEPTH_BUFFER_BIT );
+    glDrawBuffer( BufferEmuMap( GL_BACK ) );
+    glReadBuffer( BufferEmuMap( GL_BACK ) );
