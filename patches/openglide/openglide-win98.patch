@@ -125,11 +125,57 @@ void APIENTRY Dummy3ub( GLubyte a, GLubyte b, GLubyte c )
 
 // check to see if Extension is Supported
 // code by Mark J. Kilgard of NVidia modified by Fabio Barros
+//
+// Extensions that later became core OpenGL. Current drivers (and SharedGL, which
+// passes on the host's list) no longer name them, but have them from this version on.
+//
+static const struct { const char *name; int version; } coreExtensions[] =
+{
+    { "GL_EXT_vertex_array",            101 },
+    { "GL_EXT_packed_pixels",           102 },
+    { "GL_EXT_bgra",                    102 },
+    { "GL_ARB_multitexture",            103 },
+    { "GL_EXT_texture_env_add",         103 },
+    { "GL_EXT_texture_env_combine",     103 },
+    { "GL_EXT_secondary_color",         104 },
+    { "GL_EXT_fog_coord",               104 },
+    { "GL_EXT_texture_lod_bias",        104 },
+    { "GL_EXT_blend_func_separate",     104 },
+    { "GL_SGIS_generate_mipmap",        104 },
+    { NULL,                             0 }
+};
+
+static bool OGLIsCoreExtension( const char * extension )
+{
+    int ver = 0, subver = 0;
+    const char * version = (const char *)glGetString( GL_VERSION );
+
+    if ( !version || sscanf( version, "%d.%d", &ver, &subver ) != 2 )
+    {
+        return false;
+    }
+    for ( int i = 0; coreExtensions[ i ].name; i++ )
+    {
+        if ( strcmp( extension, coreExtensions[ i ].name ) == 0 )
+        {
+            return ver * 100 + subver >= coreExtensions[ i ].version;
+        }
+    }
+    return false;
+}
+
+static bool OGLIsExtensionListed( const char * extension );
+
 bool OGLIsExtensionSupported( const char * extension )
+{
+    return OGLIsExtensionListed( extension ) || OGLIsCoreExtension( extension );
+}
+
+static bool OGLIsExtensionListed( const char * extension )
 {
     const char  * extensions;
     const char  * start;
-    char        * where, 
+    char        * where,
                 * terminator;
 
     where = (char *) strchr( extension, ' ' );
