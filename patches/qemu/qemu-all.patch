--- a/hw/misc/ivshmem-win.c
+++ b/hw/misc/ivshmem-win.c
@@ -0,0 +1,259 @@
+/*
+ * ivshmem-win: an ivshmem-plain compatible PCI device, for Windows and POSIX hosts.
+ *
+ * Written for Windows hosts: upstream ivshmem depends on POSIX shared memory and
+ * memory-backend-file, neither of which exists in QEMU's Windows build. It is also
+ * built on POSIX hosts so that both hosts use the same device, with the same
+ * options (PCI IDs, bar64). It presents the same guest-visible hardware as
+ * ivshmem-plain (1af4:1110, register BAR0, 64-bit prefetchable memory BAR2, no
+ * MSI), backed by shared memory that a host process opens by name. There is no
+ * doorbell: registers read as 0.
+ *
+ * Windows: a named Win32 file mapping.
+ *   -device ivshmem-win,name=Local\sharedgl_shared_memory,size=64M
+ * POSIX: a POSIX shared memory object (shm_open, i.e. /dev/shm/NAME on Linux),
+ * or, if the name starts with '/' and has another '/' in it, that file.
+ *   -device ivshmem-win,name=sharedgl_shared_memory,size=64M
+ *   -device ivshmem-win,name=/dev/shm/sharedgl_shared_memory,size=64M
+ *
+ * bar64=off makes the memory BAR 32-bit, for guests whose PCI code predates 64-bit
+ * BARs: Windows 98 reads the upper half as a separate, broken BAR.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_device.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/blocker.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "system/memory.h"
+#ifndef _WIN32
+#include <sys/mman.h>
+#endif
+
+#define TYPE_IVSHMEM_WIN "ivshmem-win"
+OBJECT_DECLARE_SIMPLE_TYPE(IvshmemWinState, IVSHMEM_WIN)
+
+#define IVSHMEM_WIN_REG_SIZE 0x100
+
+struct IvshmemWinState {
+    PCIDevice parent_obj;
+
+    char *name;
+    uint64_t size;
+    bool bar64;
+    uint16_t vendor_id;     /* 0: keep 1af4 (Red Hat) */
+    uint16_t device_id;     /* 0: keep 1110 (ivshmem) */
+
+#ifdef _WIN32
+    HANDLE mapping;
+#endif
+    void *view;
+    MemoryRegion regs;
+    MemoryRegion shm;
+    Error *migration_blocker;
+};
+
+static uint64_t ivshmem_win_reg_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return 0;
+}
+
+static void ivshmem_win_reg_write(void *opaque, hwaddr addr, uint64_t val,
+                                  unsigned size)
+{
+}
+
+static const MemoryRegionOps ivshmem_win_reg_ops = {
+    .read = ivshmem_win_reg_read,
+    .write = ivshmem_win_reg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+/*
+ * Maps s->size bytes of the shared memory called s->name into s->view. Opens it if
+ * the host process made it first, or else creates it.
+ */
+static bool ivshmem_win_map(IvshmemWinState *s, Error **errp)
+{
+#ifdef _WIN32
+    s->mapping = CreateFileMappingA(INVALID_HANDLE_VALUE, NULL,
+                                    PAGE_READWRITE | SEC_COMMIT,
+                                    (DWORD)(s->size >> 32), (DWORD)s->size,
+                                    s->name);
+    if (!s->mapping) {
+        error_setg_win32(errp, GetLastError(),
+                         "ivshmem-win: cannot create mapping '%s'", s->name);
+        return false;
+    }
+
+    /* A mapping that already exists keeps its size, so check that it fits. */
+    s->view = MapViewOfFile(s->mapping, FILE_MAP_ALL_ACCESS, 0, 0, s->size);
+    if (!s->view) {
+        error_setg_win32(errp, GetLastError(),
+                         "ivshmem-win: cannot map %" PRIu64 " bytes of '%s'",
+                         s->size, s->name);
+        CloseHandle(s->mapping);
+        s->mapping = NULL;
+        return false;
+    }
+    return true;
+#else
+    g_autofree char *shm_name = NULL;
+    struct stat st;
+    void *view;
+    int fd;
+
+    /* "/dev/shm/x" is a file; "x" or "/x" is a POSIX shared memory object. */
+    if (s->name[0] == '/' && strchr(s->name + 1, '/')) {
+        fd = qemu_open_old(s->name, O_RDWR | O_CREAT, 0600);
+    } else {
+        shm_name = g_strdup_printf("/%s", s->name[0] == '/' ? s->name + 1 : s->name);
+        fd = shm_open(shm_name, O_RDWR | O_CREAT, 0600);
+    }
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "ivshmem-win: cannot open '%s'", s->name);
+        return false;
+    }
+
+    /* Grow it if it is new or smaller; one the host process made larger stays so. */
+    if (fstat(fd, &st) < 0 ||
+        ((uint64_t)st.st_size < s->size && ftruncate(fd, s->size) < 0)) {
+        error_setg_errno(errp, errno, "ivshmem-win: cannot size '%s' to %" PRIu64
+                         " bytes", s->name, s->size);
+        close(fd);
+        return false;
+    }
+
+    view = mmap(NULL, s->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (view == MAP_FAILED) {
+        error_setg_errno(errp, errno, "ivshmem-win: cannot map %" PRIu64
+                         " bytes of '%s'", s->size, s->name);
+        return false;
+    }
+    s->view = view;
+    return true;
+#endif
+}
+
+static void ivshmem_win_realize(PCIDevice *dev, Error **errp)
+{
+    IvshmemWinState *s = IVSHMEM_WIN(dev);
+
+    if (!s->name || !s->name[0]) {
+        error_setg(errp, "ivshmem-win: 'name' is required");
+        return;
+    }
+    if (s->size == 0 || (s->size & (s->size - 1))) {
+        error_setg(errp, "ivshmem-win: 'size' must be a power of two");
+        return;
+    }
+
+    /*
+     * Optional PCI IDs, e.g. vendor-id=0x121a,device-id=0x0002 (3dfx Voodoo2): games' setup
+     * programs (EA's 3DSetup) look for a 3dfx card in Windows' PCI device list before they offer
+     * Glide. Only the label changes; the guest driver (sgl98.inf) lists both IDs.
+     */
+    if (s->vendor_id) {
+        pci_set_word(dev->config + PCI_VENDOR_ID, s->vendor_id);
+    }
+    if (s->device_id) {
+        pci_set_word(dev->config + PCI_DEVICE_ID, s->device_id);
+    }
+
+    if (!ivshmem_win_map(s, errp)) {
+        return;
+    }
+
+    dev->config[PCI_COMMAND] = PCI_COMMAND_IO | PCI_COMMAND_MEMORY;
+    dev->config[PCI_INTERRUPT_PIN] = 1;
+
+    memory_region_init_io(&s->regs, OBJECT(s), &ivshmem_win_reg_ops, s,
+                          "ivshmem-win.regs", IVSHMEM_WIN_REG_SIZE);
+    pci_register_bar(dev, 0, PCI_BASE_ADDRESS_SPACE_MEMORY, &s->regs);
+
+    memory_region_init_ram_ptr(&s->shm, OBJECT(s), "ivshmem-win.shm",
+                               s->size, s->view);
+    pci_register_bar(dev, 2,
+                     PCI_BASE_ADDRESS_SPACE_MEMORY |
+                     PCI_BASE_ADDRESS_MEM_PREFETCH |
+                     (s->bar64 ? PCI_BASE_ADDRESS_MEM_TYPE_64 : 0),
+                     &s->shm);
+
+    error_setg(&s->migration_blocker,
+               "ivshmem-win shares memory with a host process");
+    if (migrate_add_blocker(&s->migration_blocker, errp) < 0) {
+        return;
+    }
+}
+
+static void ivshmem_win_exit(PCIDevice *dev)
+{
+    IvshmemWinState *s = IVSHMEM_WIN(dev);
+
+    migrate_del_blocker(&s->migration_blocker);
+#ifdef _WIN32
+    if (s->view) {
+        UnmapViewOfFile(s->view);
+    }
+    if (s->mapping) {
+        CloseHandle(s->mapping);
+    }
+#else
+    if (s->view) {
+        munmap(s->view, s->size);
+    }
+#endif
+}
+
+static const Property ivshmem_win_properties[] = {
+    DEFINE_PROP_STRING("name", IvshmemWinState, name),
+    DEFINE_PROP_SIZE("size", IvshmemWinState, size, 64 * MiB),
+    DEFINE_PROP_BOOL("bar64", IvshmemWinState, bar64, true),
+    DEFINE_PROP_UINT16("vendor-id", IvshmemWinState, vendor_id, 0),
+    DEFINE_PROP_UINT16("device-id", IvshmemWinState, device_id, 0),
+};
+
+static void ivshmem_win_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    k->realize = ivshmem_win_realize;
+    k->exit = ivshmem_win_exit;
+    k->vendor_id = PCI_VENDOR_ID_REDHAT_QUMRANET;
+    k->device_id = 0x1110;
+    k->class_id = PCI_CLASS_MEMORY_RAM;
+    k->revision = 1;
+    device_class_set_props(dc, ivshmem_win_properties);
+    dc->desc = "Inter-VM shared memory, opened by name (Win32 mapping or POSIX shm)";
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo ivshmem_win_info = {
+    .name = TYPE_IVSHMEM_WIN,
+    .parent = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(IvshmemWinState),
+    .class_init = ivshmem_win_class_init,
+    .interfaces = (const InterfaceInfo[]) {
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { },
+    },
+};
+
+static void ivshmem_win_register_types(void)
+{
+    type_register_static(&ivshmem_win_info);
+}
+
+type_init(ivshmem_win_register_types)
