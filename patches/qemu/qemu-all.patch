+#ifdef _WIN32
+/*
+ * QEMU's main loop on Windows sleeps in whole, rounded-up milliseconds. A guest that
+ * programs the PIT to about 1 kHz (Win9x multimedia timers) therefore gets its ticks
+ * late, and they merge in the PIC, so guest time runs at about 2/3 speed. While the
+ * PIT is that fast, wake the main loop every 0.2 ms with a high resolution timer.
+ */
+#define PIT_FAST_COUNT 6000 /* about 5 ms */
+
+static DWORD WINAPI pit_wake_thread(LPVOID opaque)
+{
+    PITChannelState *s = opaque;
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL,
+                                          CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                          TIMER_ALL_ACCESS);
+    LARGE_INTEGER due;
+
+    if (!timer) {
+        return 0;
+    }
+    due.QuadPart = -2000; /* 0.2 ms, in 100 ns units */
+    for (;;) {
+        int count = qatomic_read(&s->count);
+
+        if (count > 0 && count < PIT_FAST_COUNT) {
+            SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE);
+            WaitForSingleObject(timer, 100);
+            qemu_notify_event();
+        } else {
+            Sleep(50);
+        }
+    }
+    return 0;
+}
+#endif
